[input_devices]

virtual_controller/ios/enable_controller=false
virtual_controller/ios/enable_left_thumbstick=true
virtual_controller/ios/enable_right_thumbstick=true
virtual_controller/ios/enable_button_a=true
virtual_controller/ios/enable_button_b=true
virtual_controller/ios/enable_button_x=true
virtual_controller/ios/enable_button_y=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="one_way"
2d_physics/layer_3="player"
2d_physics/layer_4="target"
2d_physics/layer_5="enemy"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
2d/shadow_atlas/size=8192
